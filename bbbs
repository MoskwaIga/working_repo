"""Wspolne funkcje pomocnicze dla skryptow budujacych tabele *_cor."""

import calendar
import pandas as pd
import numpy as np


def months_between(start, end):
    """
    Liczba pelnych miesiecy okresu obrotowego [start, end] (oba konce
    wlacznie - tak jak raportowane 'report_period_start_dte' /
    'report_period_end_dte', np. 2021-01-01 -> 2021-12-31 = 12).

    Dziala poprawnie dla typowego przypadku (start = 1. dzien miesiaca,
    end = ostatni dzien miesiaca -> np. skrocony pierwszy rok dzialalnosci,
    polrocze, okres po polaczeniu spolek itp.) - wtedy liczy pelne miesiace
    kalendarzowe. W przeciwnym razie (np. daty "krzywe", nie na granicy
    miesiaca) liczy w przyblizeniu na podstawie liczby dni (30.44 dnia/mies.,
    zaokraglone) - takie wiersze warto pozniej przejrzec recznie.
    """
    if pd.isna(start) or pd.isna(end):
        return np.nan

    start = pd.Timestamp(start)
    end = pd.Timestamp(end)

    calendar_months = (end.year - start.year) * 12 + (end.month - start.month)
    end_is_last_day = end.day == calendar.monthrange(end.year, end.month)[1]

    if start.day == 1 and end_is_last_day:
        return int(calendar_months + 1)

    # fallback dla dat nie lezacych na granicy miesiaca
    return int(round((end - start).days / 30.44))
