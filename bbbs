from typing import Dict, List, Any

def validate_dynamic_balance_sheet(data: Dict[str, float]) -> List[Dict[str, Any]]:
    """
    Dynamicznie wykrywa strukturę bilansu ze słownika danych i waliduje sumy kontrolne.
    Obsługuje dowolny zakres sekcji głównych (np. AKTYWA_A do AKTYWA_I) 
    oraz podpozycji rzymskich (np. PASYWA_A_I do PASYWA_A_IX).
    
    Tolerancja błędu: max 1% wyższej z porównywanych wartości.
    """
    results = []

    def get_direct_children(parent_key: str) -> List[str]:
        """Znajduje bezpośrednie pozycje podrzędne (dzieci) dla wskazanego węzła."""
        prefix = parent_key + "_"
        children = []
        for key in data.keys():
            if key.startswith(prefix):
                suffix = key[len(prefix):]
                # Dziecko bezpośrednie nie zawiera kolejnych separatorów '_'
                if "_" not in suffix:
                    children.append(key)
        return sorted(children)

    def check_parent_children(parent_key: str, child_keys: List[str], label: str):
        if not child_keys or parent_key not in data:
            return

        parent_val = float(data.get(parent_key, 0.0))
        children_val = sum(float(data.get(k, 0.0)) for k in child_keys)
        diff = abs(parent_val - children_val)
        max_val = max(abs(parent_val), abs(children_val))

        # Warunek 1% wyższej wartości: diff <= 0.01 * max(parent, sum_children)
        tolerance = 0.01 * max_val if max_val > 0 else 0.0
        passed = diff <= tolerance
        rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

        results.append({
            "relacja": label,
            "rodzic": parent_key,
            "wartosc_rodzica": parent_val,
            "dzieci": child_keys,
            "suma_dzieci": children_val,
            "roznica": round(diff, 2),
            "roznica_procentowa": round(rel_diff, 2),
            "status": "PASS" if passed else "FAIL"
        })

    # --- POZIOM 0: AKTYWA == PASYWA ---
    if "AKTYWA" in data and "PASYWA" in data:
        check_parent_children("AKTYWA", ["PASYWA"], "Poziom 0: Aktywa == Pasywa")

    # --- POZIOM 1: AKTYWA / PASYWA = suma bezpośrednich grup (np. A, B, C... I) ---
    for main_key in ["AKTYWA", "PASYWA"]:
        if main_key in data:
            children = get_direct_children(main_key)
            if children:
                check_parent_children(
                    main_key, 
                    children, 
                    f"Poziom 1: {main_key} = sum({', '.join(children)})"
                )

    # --- POZIOM 2: Grupy główne = suma podpozycji (np. A_I, A_II... A_IX) ---
    level1_keys = get_direct_children("AKTYWA") + get_direct_children("PASYWA")
    for lvl1_key in level1_keys:
        children = get_direct_children(lvl1_key)
        if children:
            check_parent_children(
                lvl1_key, 
                children, 
                f"Poziom 2: {lvl1_key} = sum({', '.join(children)})"
            )

    return results
