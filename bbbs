def build_report_level_flags(df: pd.DataFrame, id_cols=ID_COLS) -> pd.DataFrame:
    # Walidacja przekazuje całą listę kolumn jako klucz
    long_results = validate_cash_flow(df, id_cols=id_cols)  # odpowiednio: validate_balance_sheet / validate_income_statement

    if long_results.empty:
        empty_df = df[id_cols].copy()
        for col in ["is_valid_sums", "has_forbidden_negative", "is_valid"]:
            empty_df[col] = pd.Series([pd.NA] * len(df), dtype="boolean")
        return empty_df

    summary = summarize_report_level(long_results, id_cols=id_cols)
    is_unknown = summary["report_status"] == "unknown_structure"

    is_valid_sums = (summary["n_mismatch"] == 0).astype("boolean").mask(is_unknown, pd.NA)
    has_forbidden_neg = (summary["n_forbidden_negative"] > 0).astype("boolean").mask(is_unknown, pd.NA)
    is_valid = is_valid_sums & (~has_forbidden_neg)

    summary["is_valid_sums"] = is_valid_sums
    summary["has_forbidden_negative"] = has_forbidden_neg
    summary["is_valid"] = is_valid

    # Zwracamy podane kolumny kluczowe oraz wyliczone flagi
    return summary[id_cols + ["is_valid_sums", "has_forbidden_negative", "is_valid"]]


def build(df: pd.DataFrame) -> pd.DataFrame:
    flags = build_report_level_flags(df, id_cols=ID_COLS)
    
    # Merge po zespole 3 kolumn
    out = df.merge(flags, on=ID_COLS, how="left")
    
    for c in ["is_valid_sums", "has_forbidden_negative", "is_valid"]:
        out[c] = out[c].astype("boolean")
        
    out["report_period_months"] = out.apply(
        lambda r: months_between(r[START_COL], r[END_COL]), axis=1
    )
    return out
