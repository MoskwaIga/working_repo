def resolve_rzis_structure(row: pd.Series) -> Optional[tuple]:
    """
    Ustala klucz do RZIS_EQUATIONS na podstawie:
      1. row["income_statement_schema"] -> np. "RZiSMala", "RZiSInna", "RZiSMikro"
      2. Fallback: row["schema_type"] (np. "Inna", "JednostkaInna") gdy RZiS schema jest NaN
      3. row["income_statement_tag"] -> "RZiSPor" / "RZiSKalk"
    """
    # 1. Próba odczytu jednostki z dedykowanej kolumny RZiS
    unit = _unit_from_schema(row.get("income_statement_schema"))

    # 2. Fallback: jeśli dedykowana schema RZiS to NaN, użyj nagłówkowej schema_type
    if unit is None:
        unit = _unit_from_schema(row.get("schema_type"))

    if unit == "mikro":
        return ("mikro", None)

    # 3. Określenie wariantu na podstawie tagu (porównawczy / kalkulacyjny)
    variant = _variant_from_tag(row.get("income_statement_tag"))
    if unit in ("mala", "inna") and variant in ("porownawczy", "kalkulacyjny"):
        return (unit, variant)

    return None
