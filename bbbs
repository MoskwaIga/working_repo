"""
Walidacja równań Bilansu zintegrowana do standardu z walidacją RZiS oraz RPP.
"""

from dataclasses import dataclass 
from typing import Optional, List 
import pandas as pd 
import numpy as np 
import re 


# ---------------------------------------------------------------------------
# 1. FUNKCJE POMOCNICZE I REGUŁY BIZNESOWE
# ---------------------------------------------------------------------------

def safe_float(val) -> float:
    """Konwertuje liczby, w tym formaty księgowe '(100)' na -100.0."""
    if pd.isna(val): 
        return 0.0 
    if isinstance(val, (int, float)): 
        return float(val) 

    val_str = str(val).strip() 
    if val_str.startswith('(') and val_str.endswith(')'): 
        val_str = '-' + val_str[1:-1] 

    try:
        return float(val_str.replace(' ', '').replace(',', '.')) 
    except (ValueError, TypeError): 
        return 0.0 


def is_forbidden_negative(key: str) -> bool:
    """
    Sprawdza, czy dana pozycja bilansowa ma bezwzględny zakaz wartości ujemnych.
    Domyślnie WSZYSTKIE pozycje muszą być >= 0 (zwraca True), 
    z wyjątkiem zdefiniowanej listy dozwolonych ujemnych pozycji korygujących.
    """
    base_key = re.sub(r'_(current|previous)$', '', key, flags=re.IGNORECASE) 

    # Zbiór dozwolonych pozycji ujemnych (obejmuje warianty z Zał. 1, 4 i 5)
    allowed_negative_keys = {
        'Aktywa_C',     # Należne wpłaty na kapitał podstawowy
        'Aktywa_D',     # Udziały (akcje) własne
        'Pasywa_A',     # Kapitał (fundusz) własny (jako suma może być ujemny przez straty)
        'Pasywa_A_IV',  # Strata netto (w schemacie Mikro)
        'Pasywa_A_V',   # Strata z lat ubiegłych (Mała) / inne zyski/straty
        'Pasywa_A_VI',  # Strata netto (Mała)
        'Pasywa_A_VII', # Strata z lat ubiegłych (Inna)
        'Pasywa_A_VIII',# Strata netto (Inna)
        'Pasywa_A_IX',  # Odpisy z zysku netto w ciągu roku obrotowego (wielkość ujemna)
    }

    # Jeśli sprawdzana pozycja jest na liście dozwolonych (lub jest dzieckiem dozwolonej pozycji, 
    # np. Pasywa_A_VII_1), to wartość ujemna jest legalna.
    for allowed_key in allowed_negative_keys:
        if base_key == allowed_key or base_key.startswith(allowed_key + '_'):
            return False 

    # Wszystkie pozostałe pozycje mają bezwzględny zakaz wartości ujemnych
    return True 


# Schematy bilansu, w których dzieci poniżej poziomu 1 (np. Aktywa_B_1, Pasywa_A_1)
# to pozycje "w tym" - informacyjny PODZBIÓR rodzica, a NIE jego wyczerpujący rozkład.
NON_EXHAUSTIVE_LEVEL2_SCHEMAS = {
    'BilansJednostkaMikro', 'SprFinJednostkaMikroWZlotych', 'JednostkaMikro', 
}


# ---------------------------------------------------------------------------
# 2. STRUKTURA WYNIKOWA
# ---------------------------------------------------------------------------

@dataclass
class EquationCheck: 
    period: str 
    equation: str 
    lhs_col: str 
    expected: float 
    actual: float 
    diff: float 
    status: str   # "ok" / "mismatch" / "forbidden_negative" / "missing_data"


# ---------------------------------------------------------------------------
# 3. ROZPOZNANIE STRUKTURY
# ---------------------------------------------------------------------------

def resolve_bs_structure(row: pd.Series, schema_col: str = 'balance_sheet_schema') -> str:
    """Zwraca schemat bilansu (np. 'BilansJednostkaMikro') lub 'unknown'."""
    schema = row.get(schema_col) 
    return str(schema) if pd.notna(schema) else "unknown"


# ---------------------------------------------------------------------------
# 4. WALIDACJA
# ---------------------------------------------------------------------------

def check_row_balance_sheet(row: pd.Series, schema_col: str = 'balance_sheet_schema',
                            tolerance_abs: float = 1.0, tolerance_rel: float = 0.0005) -> List[EquationCheck]:
    
    schema = resolve_bs_structure(row, schema_col)
    skip_level2 = schema in NON_EXHAUSTIVE_LEVEL2_SCHEMAS 
    results = []

    # Wyciągnięcie wszystkich kolumn bilansowych i konwersja na float
    balance_cols = [c for c in row.index if re.match(r'^(Aktywa|Pasywa)_', str(c), re.IGNORECASE)] 
    data = {str(col): safe_float(row[col]) for col in balance_cols} 

    # --- TEST 1: Walidacja wartości ujemnych ---
    for col_key, val in data.items(): 
        if val < 0 and is_forbidden_negative(col_key): 
            period = "current" if col_key.lower().endswith("_current") else "previous" 
            results.append(EquationCheck(
                period=period, equation=f"NoNegative_{col_key}", lhs_col=col_key,
                expected=0.0, actual=val, diff=val, status="forbidden_negative"
            ))

    # --- TEST 2: Walidacja sum kontrolnych (Poziomy 0, 1, 2) ---
    def _check_sum(parent_key: str, child_keys: list, equation_name: str, period: str):
        if not child_keys or parent_key not in data: 
            return

        parent_val = data.get(parent_key, 0.0) 
        children_vals = [data.get(k, 0.0) for k in child_keys] 
        expected = sum(children_vals) 

        all_children_zero = all(v == 0.0 for v in children_vals) 
        diff = parent_val - expected 
        
        tol = max(tolerance_abs, tolerance_rel * abs(expected)) 
        
        status = "ok" if (all_children_zero and parent_val == 0.0) or abs(diff) <= tol else "mismatch" 

        results.append(EquationCheck(
            period=period, equation=equation_name, lhs_col=parent_key,
            expected=expected, actual=parent_val, diff=diff, status=status
        ))

    for period in ["current", "previous"]: 
        # Poziom 0: Aktywa == Pasywa
        akt_lvl0, pas_lvl0 = f"Aktywa_{period}", f"Pasywa_{period}" 
        if akt_lvl0 in data and pas_lvl0 in data: 
            _check_sum(akt_lvl0, [pas_lvl0], "Poziom 0: Aktywa == Pasywa", period) 

        # Poziom 1 i 2
        for section in ["Aktywa", "Pasywa"]: 
            root = f"{section}_{period}" 
            pattern_lvl1 = re.compile(rf"^{section}_([A-Z])_{period}$", re.IGNORECASE) 

            lvl1_children = [k for k in data.keys() if pattern_lvl1.match(k)] 
            lvl1_children.sort(key=lambda x: pattern_lvl1.match(x).group(1)) 

            if lvl1_children: 
                _check_sum(root, lvl1_children, f"Poziom 1: {section}", period) 

            if skip_level2: 
                continue 

            for parent_lvl1 in lvl1_children: 
                match = pattern_lvl1.match(parent_lvl1) 
                if not match: 
                    continue 
                letter = match.group(1) 
                
                # Łapiemy numerację rzymską i arabską
                pattern_lvl2 = re.compile(
                    rf"^{section}_{letter}_([IVXLCDM]+|\d+)_{period}$", re.IGNORECASE 
                )

                lvl2_children = [k for k in data.keys() if pattern_lvl2.match(k)] 
                if lvl2_children: 
                    _check_sum(parent_lvl1, lvl2_children, f"Poziom 2: {section}_{letter}", period) 

    return results


def validate_balance_sheet(df: pd.DataFrame,
                           id_cols=("krs", "report_id", "period_to"), 
                           schema_col: str = "balance_sheet_schema",
                           tolerance_abs: float = 1.0,
                           tolerance_rel: float = 0.0005) -> pd.DataFrame:
    """Zwraca 'długą' tabelę: jeden wiersz na (raport, okres, równanie)."""
    id_cols = [c for c in id_cols if c in df.columns] 
    rows_out = [] 
    
    for _, row in df.iterrows(): 
        structure = resolve_bs_structure(row, schema_col)
        for chk in check_row_balance_sheet(row, schema_col, tolerance_abs, tolerance_rel):
            rows_out.append({
                **{c: row[c] for c in id_cols}, 
                "bs_structure": structure,
                "period": chk.period, 
                "equation": chk.equation, 
                "expected": chk.expected, 
                "actual": chk.actual, 
                "diff": chk.diff, 
                "status": chk.status, 
            })
            
    return pd.DataFrame(rows_out) 


def summarize_report_level(results: pd.DataFrame,
                           id_cols=("krs", "report_id", "period_to")) -> pd.DataFrame: 
    id_cols = [c for c in id_cols if c in results.columns] 

    def worst_status(s): 
        if (s == "forbidden_negative").any():
            return "forbidden_negative"
        if (s == "mismatch").any(): 
            return "mismatch" 
        if (s == "missing_data").any(): 
            return "missing_data" 
        if (s == "unknown_structure").any(): 
            return "unknown_structure" 
        return "ok" 

    grouped = results.groupby(id_cols).agg(
        bs_structure=("bs_structure", "first"),
        n_equations=("equation", "count"), 
        n_mismatch=("status", lambda s: (s == "mismatch").sum()), 
        n_forbidden_negative=("status", lambda s: (s == "forbidden_negative").sum()),
        max_abs_diff=("diff", lambda s: s.abs().max()), 
        report_status=("status", worst_status), 
    ).reset_index() 

    return grouped


def rejection_rate_by_structure(report_level: pd.DataFrame) -> pd.DataFrame: 
    return (
        report_level
        .groupby("bs_structure")
        .agg(
            n_reports=("report_status", "size"), 
            n_mismatch=("report_status", lambda s: (s == "mismatch").sum()), 
            n_forbidden_negative=("report_status", lambda s: (s == "forbidden_negative").sum()),
        )
        .assign(pct_mismatch=lambda d: (d["n_mismatch"] / d["n_reports"] * 100).round(1)) 
        .sort_values("n_reports", ascending=False) 
    )
