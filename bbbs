def build_report_level_flags(df: pd.DataFrame, id_cols=ID_COLS) -> pd.DataFrame:
    long_results = validate_cash_flow(df, id_cols=id_cols)

    if long_results.empty:
        empty_df = df[id_cols].copy()
        for col in ["is_valid_sums", "has_forbidden_negative", "bilansowa_zmiana_niespojna", "is_valid"]:
            empty_df[col] = pd.Series([pd.NA] * len(df), dtype="boolean")
        return empty_df

    summary = summarize_report_level(long_results, id_cols=id_cols)
    is_unknown = summary["report_status"] == "unknown_structure"

    # Zabezpieczenie na poziomie podsumowania
    if "bilansowa_zmiana_niespojna" not in summary.columns:
        summary["bilansowa_zmiana_niespojna"] = pd.Series([pd.NA] * len(summary), dtype="boolean")

    is_valid_sums = (summary["n_mismatch"] == 0).astype("boolean").mask(is_unknown, pd.NA)
    has_forbidden_neg = (summary["n_forbidden_negative"] > 0).astype("boolean").mask(is_unknown, pd.NA)
    bilansowa_niespojna = summary["bilansowa_zmiana_niespojna"].astype("boolean").mask(is_unknown, pd.NA)

    is_valid = is_valid_sums & (~has_forbidden_neg)

    summary["is_valid_sums"] = is_valid_sums
    summary["has_forbidden_negative"] = has_forbidden_neg
    summary["bilansowa_zmiana_niespojna"] = bilansowa_niespojna
    summary["is_valid"] = is_valid

    return summary[id_cols + ["is_valid_sums", "has_forbidden_negative", "bilansowa_zmiana_niespojna", "is_valid"]]
