import re
import pandas as pd


def safe_float(val) -> float:
    if pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)
    val_str = str(val).strip()
    if val_str.startswith("(") and val_str.endswith(")"):
        val_str = "-" + val_str[1:-1]
    try:
        return float(val_str.replace(" ", "").replace(",", "."))
    except (ValueError, TypeError):
        return 0.0


def detect_variant(data: dict, p: str) -> str:
    """Automatycznie identyfikuje wariant RZiS na podstawie dostępnych kluczy oraz spójności wzorów."""
    if f"O_{p}" in data:
        return "INNA_KALKULACYJNY"
    if f"G_{p}" in data and f"H_{p}" not in data:
        return "MIKRO"
    if f"J_{p}" in data and f"K_{p}" not in data and f"L_{p}" not in data:
        return "MALA_POROWNAWCZY"
    if f"L_{p}" in data and f"E_{p}" in data:
        val_a, val_b = data.get(f"A_{p}", 0.0), data.get(f"B_{p}", 0.0)
        val_c, val_d = data.get(f"C_{p}", 0.0), data.get(f"D_{p}", 0.0)
        val_e = data.get(f"E_{p}", 0.0)

        diff_inna_porow = abs(val_c - (val_a - val_b))
        diff_mala_kalk = abs(val_e - (val_a - val_b - val_c - val_d))
        if diff_mala_kalk < diff_inna_porow:
            return "MALA_KALKULACYJNY"

    return "INNA_POROWNAWCZY"


def validate_rzis_df(
    df: pd.DataFrame, abs_tolerance: float = 1.0
) -> pd.DataFrame:
    results = []
    rzis_pattern = re.compile(
        r"^[A-Z](?:_[A-Z0-9a-z]+)*_(current|previous)$", re.IGNORECASE
    )
    rzis_cols = [c for c in df.columns if rzis_pattern.match(str(c))]

    for row_idx, row in df.iterrows():
        data = {str(col): safe_float(row[col]) for col in rzis_cols}
        krs = row.get("krs", row_idx)
        period_end_dte = row.get("report_period_end_dte", None)

        for p in ["current", "previous"]:
            variant = detect_variant(data, p)

            def check_eq(target_key: str, calc_val: float, label: str):
                if target_key not in data:
                    return
                target_val = data.get(target_key, 0.0)
                diff = abs(target_val - calc_val)
                max_val = max(abs(target_val), abs(calc_val))

                tolerance = max(abs_tolerance, 0.0001 * max_val)
                passed = diff <= tolerance
                rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

                results.append(
                    {
                        "krs": krs,
                        "report_period_end_dte": period_end_dte,
                        "analizowany_okres": p,
                        "wariant_rzis": variant,
                        "relacja": label,
                        "pozycja_wykazana": target_key,
                        "wartosc_wykazana": round(target_val, 2),
                        "wartosc_obliczona": round(calc_val, 2),
                        "roznica": round(diff, 2),
                        "roznica_procentowa": round(rel_diff, 2),
                        "status": "PASS" if passed else "FAIL",
                    }
                )

            # --- WALIDACJA STRUKTURALNA (KASKADOWA) ---
            if variant == "MIKRO":
                # 1. RZiSJednostkaMicro
                check_eq(
                    f"F_{p}",
                    data.get(f"A_{p}", 0.0)
                    - data.get(f"B_{p}", 0.0)
                    + data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = A - B + C - D - E",
                )
                check_eq(f"G_{p}", data.get(f"F_{p}", 0.0), f"{p} - G = F")

            elif variant == "MALA_POROWNAWCZY":
                # 2. RZiSJednostkaMala + RZiSPor
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"H_{p}",
                    data.get(f"C_{p}", 0.0)
                    + data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0)
                    + data.get(f"F_{p}", 0.0)
                    - data.get(f"G_{p}", 0.0),
                    f"{p} - H = C + D - E + F - G",
                )
                check_eq(
                    f"J_{p}",
                    data.get(f"H_{p}", 0.0) - data.get(f"I_{p}", 0.0),
                    f"{p} - J = H - I",
                )

            elif variant == "MALA_KALKULACYJNY":
                # 3. RZiSJednostkaMala + RZiSKalk
                check_eq(
                    f"E_{p}",
                    data.get(f"A_{p}", 0.0)
                    - data.get(f"B_{p}", 0.0)
                    - data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0),
                    f"{p} - E = A - B - C - D",
                )
                check_eq(
                    f"J_{p}",
                    data.get(f"E_{p}", 0.0)
                    + data.get(f"F_{p}", 0.0)
                    - data.get(f"G_{p}", 0.0)
                    + data.get(f"H_{p}", 0.0)
                    - data.get(f"I_{p}", 0.0),
                    f"{p} - J = E + F - G + H - I",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"J_{p}", 0.0) - data.get(f"K_{p}", 0.0),
                    f"{p} - L = J - K",
                )

            elif variant == "INNA_KALKULACYJNY":
                # 4. RZiSJednostkaInna + RZiSKalk
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"F_{p}",
                    data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = C - D - E",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - I = F + G - H",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"I_{p}", 0.0)
                    + data.get(f"J_{p}", 0.0)
                    - data.get(f"K_{p}", 0.0),
                    f"{p} - L = I + J - K",
                )
                check_eq(
                    f"O_{p}",
                    data.get(f"L_{p}", 0.0)
                    - data.get(f"M_{p}", 0.0)
                    - data.get(f"N_{p}", 0.0),
                    f"{p} - O = L - M - N",
                )

            elif variant == "INNA_POROWNAWCZY":
                # 5. RZiSJednostkaInna + RZiSPor
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"F_{p}",
                    data.get(f"C_{p}", 0.0)
                    + data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = C + D - E",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - I = F + G - H",
                )
                check_eq(
                    f"K_{p}",
                    data.get(f"I_{p}", 0.0) - data.get(f"J_{p}", 0.0),
                    f"{p} - K = I - J",
                )

            # --- WALIDACJA HIERARCHICZNA (SUMOWANIE DRZEWA PODPOZYCJI) ---
            for parent_key in list(data.keys()):
                if not parent_key.lower().endswith(f"_{p}"):
                    continue

                base_name = parent_key[: -len(f"_{p}")]
                child_pattern = re.compile(
                    rf"^{re.escape(base_name)}_[^_]+_{p}$", re.IGNORECASE
                )
                child_keys = [k for k in data.keys() if child_pattern.match(k)]

                if child_keys:
                    calc_sum = sum(data.get(k, 0.0) for k in child_keys)
                    check_eq(
                        parent_key,
                        calc_sum,
                        f"{p} - Suma podpozycji dla {base_name}",
                    )

    return pd.DataFrame(results)
