import re
import pandas as pd

def validate_balance_sheet_df(df: pd.DataFrame) -> pd.DataFrame:
    """
    Waliduje sumy kontrolne bilansu w DataFrame do 2 poziomów w dół.
    
    Uwzględnia:
    - Kolumnę 'report_period_end_dte' w tabeli wynikowej.
    - Automatyczny status 'PASS', jeśli spółka nie raportuje podpozycji (wszystkie dzieci = 0.0).
    - Tolerancję odchylenia do 1% wyższej wartości.
    """
    results = []

    # Wybór kolumn z danymi bilansowymi
    balance_cols = [c for c in df.columns if re.match(r'^(Aktywa|Pasywa)_', str(c), re.IGNORECASE)]

    for row_idx, row in df.iterrows():
        # Zasilanie słownika czystymi wartościami liczbowymi
        data = {}
        for col in balance_cols:
            val = row[col]
            try:
                data[str(col)] = float(val) if pd.notna(val) else 0.0
            except (ValueError, TypeError):
                data[str(col)] = 0.0

        # Identyfikator podmiotu i data okresu
        row_id = row.get('krs', row.get('KRS', row_idx))
        period_end_dte = row.get('report_period_end_dte', None)

        periods = ["current", "previous"]

        def check_sum(parent_key: str, child_keys: list, label: str):
            if not child_keys or parent_key not in data:
                return

            parent_val = data.get(parent_key, 0.0)
            children_vals = [data.get(k, 0.0) for k in child_keys]
            children_val = sum(children_vals)
            
            # Warunek braku raportowania: wszystkie dzieci mają wartość 0.0
            all_children_zero = all(v == 0.0 for v in children_vals)

            diff = abs(parent_val - children_val)
            max_val = max(abs(parent_val), abs(children_val))

            tolerance = 0.01 * max_val if max_val > 0 else 0.0
            
            # Jeśli brak raportowania uszczegółowienia (sam zeros) -> zaliczamy jako PASS
            if all_children_zero:
                passed = True
            else:
                passed = diff <= tolerance

            rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

            results.append({
                "row_id": row_id,
                "report_period_end_dte": period_end_dte,
                "analizowany_okres": label.split()[0],
                "relacja": label,
                "rodzic": parent_key,
                "wartosc_rodzica": parent_val,
                "dzieci": child_keys,
                "suma_dzieci": children_val,
                "roznica": round(diff, 2),
                "roznica_procentowa": round(rel_diff, 2),
                "status": "PASS" if passed else "FAIL"
            })

        for period in periods:
            # --- POZIOM 0: Aktywa == Pasywa ---
            akt_lvl0 = f"Aktywa_{period}"
            pas_lvl0 = f"Pasywa_{period}"
            if akt_lvl0 in data and pas_lvl0 in data:
                check_sum(akt_lvl0, [pas_lvl0], f"{period} - Poziom 0: Aktywa == Pasywa")

            # --- POZIOM 1: Aktywa/Pasywa = Litery (A..I) ---
            for section in ["Aktywa", "Pasywa"]:
                root = f"{section}_{period}"
                pattern_lvl1 = re.compile(rf"^{section}_([A-I])_{period}$", re.IGNORECASE)

                lvl1_children = [k for k in data.keys() if pattern_lvl1.match(k)]
                lvl1_children.sort(key=lambda x: pattern_lvl1.match(x).group(1))

                if lvl1_children:
                    check_sum(root, lvl1_children, f"{period} - Poziom 1: {section} = sum(A..I)")

                # --- POZIOM 2: Litera (A..I) = Liczby rzymskie (I..X) ---
                for parent_lvl1 in lvl1_children:
                    match = pattern_lvl1.match(parent_lvl1)
                    if not match:
                        continue
                    letter = match.group(1)
                    pattern_lvl2 = re.compile(rf"^{section}_{letter}_([IVXLCDM]+)_{period}$", re.IGNORECASE)

                    lvl2_children = [k for k in data.keys() if pattern_lvl2.match(k)]
                    if lvl2_children:
                        check_sum(
                            parent_lvl1,
                            lvl2_children,
                            f"{period} - Poziom 2: {section}_{letter} = sum(I..X)"
                        )

    return pd.DataFrame(results)
