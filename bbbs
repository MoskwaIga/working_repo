from pathlib import Path
import pandas as pd

# Importujemy nowe funkcje z zaktualizowanego modułu
from validate_balance_sheet import validate_balance_sheet, summarize_report_level
from common import months_between

# --- KONFIG: dostosuj sciezki i nazwy kolumn do swoich danych ---
INPUT_PATH = "data/stage/balance_sheet.parquet"
OUTPUT_PATH = "data/stage/balance_sheet_cor.parquet"
ID_COL = "report_id"
START_COL = "report_period_start_dte"
END_COL = "report_period_end_dte"


def build_report_level_flags(df: pd.DataFrame, id_col: str = ID_COL) -> pd.DataFrame:
    """Zwraca DataFrame [id_col, is_valid_sums, has_forbidden_negative] wyliczony 
    za pomocą funkcji podsumowującej z modułu walidacji."""
    long_results = validate_balance_sheet(df, id_cols=(id_col,))

    if long_results.empty:
        return pd.DataFrame({
            id_col: df[id_col],
            "is_valid_sums": pd.Series([pd.NA] * len(df), dtype="boolean"),
            "has_forbidden_negative": pd.Series([pd.NA] * len(df), dtype="boolean")
        })

    # Korzystamy z gotowej agregacji z modułu walidacyjnego
    summary = summarize_report_level(long_results, id_cols=(id_col,))

    # Mapujemy zagregowane zliczenia na flagi logiczne
    summary["is_valid_sums"] = (summary["n_mismatch"] == 0).astype("boolean")
    summary["has_forbidden_negative"] = (summary["n_forbidden_negative"] > 0).astype("boolean")

    return summary[[id_col, "is_valid_sums", "has_forbidden_negative"]]


def build(df: pd.DataFrame) -> pd.DataFrame:
    flags = build_report_level_flags(df)

    out = df.merge(flags, on=ID_COL, how="left")
    
    out["is_valid_sums"] = out["is_valid_sums"].astype("boolean")
    out["has_forbidden_negative"] = out["has_forbidden_negative"].astype("boolean")

    out["report_period_months"] = out.apply(
        lambda r: months_between(r[START_COL], r[END_COL]), axis=1
    )
    return out


if __name__ == "__main__":
    df_in = pd.read_parquet(INPUT_PATH)
    df_out = build(df_in)

    out_path = Path(OUTPUT_PATH)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    df_out.to_parquet(out_path, index=False)

    print(f"Zapisano {len(df_out)} wierszy -> {out_path}")
    print(df_out[["is_valid_sums", "has_forbidden_negative"]].value_counts(dropna=False))
