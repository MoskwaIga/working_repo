import re
import pandas as pd


def safe_float(val) -> float:
    if pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)
    val_str = str(val).strip()
    if val_str.startswith("(") and val_str.endswith(")"):
        val_str = "-" + val_str[1:-1]
    try:
        return float(val_str.replace(" ", "").replace(",", "."))
    except (ValueError, TypeError):
        return 0.0


def detect_variant(row: pd.Series, data: dict, p: str) -> str:
    """Identyfikuje wariant RZiS:

    1. Priorytetowo na podstawie metadanych (schema_type,
    income_statement_schema itp.)
    2. Fallback na podstawie faktycznie wypełnionych (niezerowych) pozycji.
    """
    # 1. Sprawdzanie metadanych w wierszu
    meta_cols = [
        "schema_type",
        "income_statement_schema",
        "income_statement_tag",
        "wariant_rzis",
        "wariant",
        "variant",
    ]
    meta_val = " ".join(
        [str(row[c]).upper() for c in meta_cols if c in row and pd.notna(row[c])]
    )

    if meta_val:
        is_micro = "MICRO" in meta_val or "MIKRO" in meta_val
        is_mala = "MALA" in meta_val or "MAŁA" in meta_val or "SMALL" in meta_val
        is_inna = "INNA" in meta_val or "OTHER" in meta_val
        is_kalk = "KALK" in meta_val or "CALC" in meta_val
        is_por = "POR" in meta_val or "COMPAR" in meta_val

        if is_micro:
            return "MIKRO"
        if is_mala and is_kalk:
            return "MALA_KALKULACYJNY"
        if is_mala and is_por:
            return "MALA_POROWNAWCZY"
        if is_inna and is_kalk:
            return "INNA_KALKULACYJNY"
        if is_inna and is_por:
            return "INNA_POROWNAWCZY"

    # 2. Fallback: weryfikacja niezerowych wartości w danych
    def has_val(key: str) -> bool:
        val = data.get(key, 0.0)
        return pd.notna(val) and abs(val) > 1e-6

    if has_val(f"O_{p}"):
        return "INNA_KALKULACYJNY"
    if has_val(f"F_{p}") and not has_val(f"G_{p}") and not has_val(f"H_{p}"):
        return "MIKRO"
    if has_val(f"J_{p}") and not has_val(f"K_{p}") and not has_val(f"L_{p}"):
        return "MALA_POROWNAWCZY"
    if has_val(f"L_{p}") and has_val(f"E_{p}"):
        val_a, val_b = data.get(f"A_{p}", 0.0), data.get(f"B_{p}", 0.0)
        val_c, val_d = data.get(f"C_{p}", 0.0), data.get(f"D_{p}", 0.0)
        val_e = data.get(f"E_{p}", 0.0)

        diff_inna_porow = abs(val_c - (val_a - val_b))
        diff_mala_kalk = abs(val_e - (val_a - val_b - val_c - val_d))
        if diff_mala_kalk < diff_inna_porow:
            return "MALA_KALKULACYJNY"

    return "INNA_POROWNAWCZY"


def validate_rzis_df(
    df: pd.DataFrame, abs_tolerance: float = 1.0
) -> pd.DataFrame:
    results = []

    # Dopasowuje wszystkie struktury RZiS (np. A_I_1_a_current, G_I_A_current)
    rzis_pattern = re.compile(
        r"^[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*_(current|previous)$", re.IGNORECASE
    )
    rzis_cols = [c for c in df.columns if rzis_pattern.match(str(c))]

    for row_idx, row in df.iterrows():
        data = {str(col): safe_float(row[col]) for col in rzis_cols}
        krs = row.get("krs", row_idx)
        period_end_dte = row.get("report_period_end_dte", None)

        for p in ["current", "previous"]:
            variant = detect_variant(row, data, p)

            def check_eq(target_key: str, calc_val: float, label: str):
                if target_key not in data:
                    return
                target_val = data.get(target_key, 0.0)
                diff = abs(target_val - calc_val)
                max_val = max(abs(target_val), abs(calc_val))

                tolerance = max(abs_tolerance, 0.0001 * max_val)
                passed = diff <= tolerance
                rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

                results.append(
                    {
                        "krs": krs,
                        "report_period_end_dte": period_end_dte,
                        "analizowany_okres": p,
                        "wariant_rzis": variant,
                        "relacja": label,
                        "pozycja_wykazana": target_key,
                        "wartosc_wykazana": round(target_val, 2),
                        "wartosc_obliczona": round(calc_val, 2),
                        "roznica": round(diff, 2),
                        "roznica_procentowa": round(rel_diff, 2),
                        "status": "PASS" if passed else "FAIL",
                    }
                )

            # --- WALIDACJA STRUKTURALNA (KASKADOWA) ---
            if variant == "MIKRO":
                # F = A - B + C - D - E (usunięto G = F)
                check_eq(
                    f"F_{p}",
                    data.get(f"A_{p}", 0.0)
                    - data.get(f"B_{p}", 0.0)
                    + data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = A - B + C - D - E",
                )

            elif variant == "MALA_POROWNAWCZY":
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"H_{p}",
                    data.get(f"C_{p}", 0.0)
                    + data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0)
                    + data.get(f"F_{p}", 0.0)
                    - data.get(f"G_{p}", 0.0),
                    f"{p} - H = C + D - E + F - G",
                )
                check_eq(
                    f"J_{p}",
                    data.get(f"H_{p}", 0.0) - data.get(f"I_{p}", 0.0),
                    f"{p} - J = H - I",
                )

            elif variant == "MALA_KALKULACYJNY":
                check_eq(
                    f"E_{p}",
                    data.get(f"A_{p}", 0.0)
                    - data.get(f"B_{p}", 0.0)
                    - data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0),
                    f"{p} - E = A - B - C - D",
                )
                check_eq(
                    f"J_{p}",
                    data.get(f"E_{p}", 0.0)
                    + data.get(f"F_{p}", 0.0)
                    - data.get(f"G_{p}", 0.0)
                    + data.get(f"H_{p}", 0.0)
                    - data.get(f"I_{p}", 0.0),
                    f"{p} - J = E + F - G + H - I",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"J_{p}", 0.0) - data.get(f"K_{p}", 0.0),
                    f"{p} - L = J - K",
                )

            elif variant == "INNA_KALKULACYJNY":
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"F_{p}",
                    data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = C - D - E",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - I = F + G - H",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"I_{p}", 0.0)
                    + data.get(f"J_{p}", 0.0)
                    - data.get(f"K_{p}", 0.0),
                    f"{p} - L = I + J - K",
                )
                check_eq(
                    f"O_{p}",
                    data.get(f"L_{p}", 0.0)
                    - data.get(f"M_{p}", 0.0)
                    - data.get(f"N_{p}", 0.0),
                    f"{p} - O = L - M - N",
                )

            elif variant == "INNA_POROWNAWCZY":
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"F_{p}",
                    data.get(f"C_{p}", 0.0)
                    + data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = C + D - E",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - I = F + G - H",
                )
                check_eq(
                    f"K_{p}",
                    data.get(f"I_{p}", 0.0) - data.get(f"J_{p}", 0.0),
                    f"{p} - K = I - J",
                )

            # --- WALIDACJA HIERARCHICZNA (SEGMENTOWA) ---
            # Precyzyjne dopasowanie bezpośrednich dzieci po segmentach klucza
            for parent_key in list(data.keys()):
                if not parent_key.lower().endswith(f"_{p}"):
                    continue

                base_name = parent_key[: -len(f"_{p}")]
                parent_parts = base_name.split("_")

                child_keys = []
                for k in data.keys():
                    if not k.lower().endswith(f"_{p}"):
                        continue
                    child_base = k[: -len(f"_{p}")]
                    child_parts = child_base.split("_")

                    # Dziecko bezpośrednie ma dokładnie o 1 segment więcej i współdzieli prefiks
                    if (
                        len(child_parts) == len(parent_parts) + 1
                        and child_parts[: len(parent_parts)] == parent_parts
                    ):
                        child_keys.append(k)

                if child_keys:
                    calc_sum = sum(data.get(k, 0.0) for k in child_keys)
                    check_eq(
                        parent_key,
                        calc_sum,
                        f"{p} - Suma podpozycji dla {base_name}",
                    )

    return pd.DataFrame(results)
