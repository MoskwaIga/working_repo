import re
import pandas as pd


def safe_float(val) -> float:
    if pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)
    val_str = str(val).strip()
    if val_str.startswith("(") and val_str.endswith(")"):
        val_str = "-" + val_str[1:-1]
    try:
        return float(val_str.replace(" ", "").replace(",", "."))
    except (ValueError, TypeError):
        return 0.0


def detect_variant(row: pd.Series, data: dict, p: str) -> str:
    """Detekcja wariantu RZiS z priorytetem dla income_statement_schema i income_statement_tag."""
    schema = str(row.get("income_statement_schema", "")).strip().lower()
    tag = str(row.get("income_statement_tag", "")).strip().lower()
    combined_meta = f"{schema} {tag}".strip()

    # Fallback na inne kolumny metadanych
    if not combined_meta:
        meta_cols = ["schema_type", "wariant_rzis", "wariant", "variant"]
        combined_meta = " ".join(
            [
                str(row[c]).lower()
                for c in meta_cols
                if c in row and pd.notna(row[c])
            ]
        )

    # 1. Determinacja na podstawie metadanych (schema / tag)
    if combined_meta:
        if "mikro" in combined_meta or "micro" in combined_meta:
            if (
                "pelny" in combined_meta
                or "pełny" in combined_meta
                or f"N_{p}" in data
            ):
                return "MIKRO_PELNY"
            return "MIKRO_UPROSZCZONY"

        is_mala = (
            "mala" in combined_meta
            or "mała" in combined_meta
            or "small" in combined_meta
        )
        is_inna = "inna" in combined_meta or "other" in combined_meta
        is_kalk = "kalk" in combined_meta or "calc" in combined_meta
        is_por = "por" in combined_meta or "compar" in combined_meta

        if is_mala and is_kalk:
            return "MALA_KALKULACYJNY"
        if is_mala and is_por:
            return "MALA_POROWNAWCZY"
        if is_inna and is_kalk:
            return "INNA_KALKULACYJNY"
        if is_inna and is_por:
            return "INNA_POROWNAWCZY"

        if is_kalk:
            return (
                "INNA_KALKULACYJNY" if f"O_{p}" in data else "MALA_KALKULACYJNY"
            )
        if is_por:
            return (
                "MALA_POROWNAWCZY"
                if (f"H_{p}" in data and f"J_{p}" in data and f"K_{p}" not in data)
                else "INNA_POROWNAWCZY"
            )

    # 2. Fallback na podstawie układu wypełnionych kluczy w danych
    def has_val(key: str) -> bool:
        val = data.get(key, 0.0)
        return pd.notna(val) and abs(val) > 1e-6

    if has_val(f"N_{p}") and has_val(f"L_{p}"):
        return "MIKRO_PELNY"
    if has_val(f"O_{p}"):
        return "INNA_KALKULACYJNY"
    if has_val(f"F_{p}") and not has_val(f"G_{p}") and not has_val(f"H_{p}"):
        return "MIKRO_UPROSZCZONY"
    if has_val(f"H_{p}") and has_val(f"J_{p}") and not has_val(f"K_{p}"):
        return "MALA_POROWNAWCZY"
    if has_val(f"E_{p}") and has_val(f"L_{p}") and not has_val(f"O_{p}"):
        return "MALA_KALKULACYJNY"

    return "INNA_POROWNAWCZY"


def validate_rzis_df(
    df: pd.DataFrame, abs_tolerance: float = 1.0
) -> pd.DataFrame:
    results = []
    rzis_pattern = re.compile(
        r"^[A-Za-z0-9]+(?:_[A-Za-z0-9]+)*_(current|previous)$", re.IGNORECASE
    )
    rzis_cols = [c for c in df.columns if rzis_pattern.match(str(c))]

    for row_idx, row in df.iterrows():
        data = {str(col): safe_float(row[col]) for col in rzis_cols}
        krs = row.get("krs", row_idx)
        period_end_dte = row.get("report_period_end_dte", None)

        for p in ["current", "previous"]:
            variant = detect_variant(row, data, p)

            def check_eq(target_key: str, calc_val: float, label: str):
                if target_key not in data:
                    return
                target_val = data.get(target_key, 0.0)
                diff = abs(target_val - calc_val)
                max_val = max(abs(target_val), abs(calc_val))

                tolerance = max(abs_tolerance, 0.0001 * max_val)
                passed = diff <= tolerance
                rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

                results.append(
                    {
                        "krs": krs,
                        "report_period_end_dte": period_end_dte,
                        "analizowany_okres": p,
                        "wariant_rzis": variant,
                        "relacja": label,
                        "pozycja_wykazana": target_key,
                        "wartosc_wykazana": round(target_val, 2),
                        "wartosc_obliczona": round(calc_val, 2),
                        "roznica": round(diff, 2),
                        "roznica_procentowa": round(rel_diff, 2),
                        "status": "PASS" if passed else "FAIL",
                    }
                )

            # --- WALIDACJA STRUKTURALNA (KASKADOWA) ---
            if variant == "MIKRO_UPROSZCZONY":
                # 1. Mikro uproszczony
                check_eq(
                    f"F_{p}",
                    data.get(f"A_{p}", 0.0)
                    - data.get(f"B_{p}", 0.0)
                    + data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = A - B + C - D - E",
                )

            elif variant == "MIKRO_PELNY":
                # 2. Mikro pełny
                check_eq(
                    f"F_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - F = A - B",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0),
                    f"{p} - I = F + C - D",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"I_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - L = I + G - H",
                )
                check_eq(
                    f"N_{p}",
                    data.get(f"L_{p}", 0.0)
                    - data.get(f"J_{p}", 0.0)
                    - data.get(f"K_{p}", 0.0),
                    f"{p} - N = L - J - K",
                )

            elif variant == "MALA_POROWNAWCZY":
                # 3. Porównawczy (Mała)
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"H_{p}",
                    data.get(f"C_{p}", 0.0)
                    + data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0)
                    + data.get(f"F_{p}", 0.0)
                    - data.get(f"G_{p}", 0.0),
                    f"{p} - H = C + D - E + F - G",
                )
                check_eq(
                    f"J_{p}",
                    data.get(f"H_{p}", 0.0) - data.get(f"I_{p}", 0.0),
                    f"{p} - J = H - I",
                )

            elif variant == "INNA_POROWNAWCZY":
                # 3. Porównawczy (Inna)
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"F_{p}",
                    data.get(f"C_{p}", 0.0)
                    + data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = C + D - E",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - I = F + G - H",
                )
                check_eq(
                    f"K_{p}",
                    data.get(f"I_{p}", 0.0) - data.get(f"J_{p}", 0.0),
                    f"{p} - K = I - J",
                )

                if f"L_{p}" in data:
                    check_eq(
                        f"L_{p}",
                        data.get(f"I_{p}", 0.0)
                        + data.get(f"J_{p}", 0.0)
                        - data.get(f"K_{p}", 0.0),
                        f"{p} - L = I + J - K",
                    )

            elif variant == "MALA_KALKULACYJNY":
                # 4. Kalkulacyjny (Mała)
                check_eq(
                    f"E_{p}",
                    data.get(f"A_{p}", 0.0)
                    - data.get(f"B_{p}", 0.0)
                    - data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0),
                    f"{p} - E = A - B - C - D",
                )
                check_eq(
                    f"J_{p}",
                    data.get(f"E_{p}", 0.0)
                    + data.get(f"F_{p}", 0.0)
                    - data.get(f"G_{p}", 0.0)
                    + data.get(f"H_{p}", 0.0)
                    - data.get(f"I_{p}", 0.0),
                    f"{p} - J = E + F - G + H - I",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"J_{p}", 0.0) - data.get(f"K_{p}", 0.0),
                    f"{p} - L = J - K",
                )

            elif variant == "INNA_KALKULACYJNY":
                # 4. Kalkulacyjny (Inna)
                check_eq(
                    f"C_{p}",
                    data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0),
                    f"{p} - C = A - B",
                )
                check_eq(
                    f"F_{p}",
                    data.get(f"C_{p}", 0.0)
                    - data.get(f"D_{p}", 0.0)
                    - data.get(f"E_{p}", 0.0),
                    f"{p} - F = C - D - E",
                )
                check_eq(
                    f"I_{p}",
                    data.get(f"F_{p}", 0.0)
                    + data.get(f"G_{p}", 0.0)
                    - data.get(f"H_{p}", 0.0),
                    f"{p} - I = F + G - H",
                )
                check_eq(
                    f"L_{p}",
                    data.get(f"I_{p}", 0.0)
                    + data.get(f"J_{p}", 0.0)
                    - data.get(f"K_{p}", 0.0),
                    f"{p} - L = I + J - K",
                )
                check_eq(
                    f"O_{p}",
                    data.get(f"L_{p}", 0.0)
                    - data.get(f"M_{p}", 0.0)
                    - data.get(f"N_{p}", 0.0),
                    f"{p} - O = L - M - N",
                )

            # --- WALIDACJA HIERARCHICZNA (SEGMENTOWA) ---
            for parent_key in list(data.keys()):
                if not parent_key.lower().endswith(f"_{p}"):
                    continue

                base_name = parent_key[: -len(f"_{p}")]
                parent_parts = base_name.split("_")

                child_keys = []
                for k in data.keys():
                    if not k.lower().endswith(f"_{p}"):
                        continue
                    child_base = k[: -len(f"_{p}")]
                    child_parts = child_base.split("_")

                    if (
                        len(child_parts) == len(parent_parts) + 1
                        and child_parts[: len(parent_parts)] == parent_parts
                    ):
                        child_keys.append(k)

                if child_keys:
                    calc_sum = sum(data.get(k, 0.0) for k in child_keys)
                    check_eq(
                        parent_key,
                        calc_sum,
                        f"{p} - Suma podpozycji dla {base_name}",
                    )

    return pd.DataFrame(results)
