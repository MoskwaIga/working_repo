import re
import pandas as pd
from typing import Dict, List, Optional, Set

def safe_float(val) -> float:
    """Konwertuje liczby, w tym formaty księgowe '(100)' na -100.0 oraz czyści białe znaki."""
    if pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)

    # Czyszczenie spacji (w tym twardych spacji \xa0)
    val_str = str(val).replace('\xa0', '').strip()
    if not val_str:
        return 0.0

    if val_str.startswith('(') and val_str.endswith(')'):
        val_str = '-' + val_str[1:-1]

    try:
        return float(val_str.replace(' ', '').replace(',', '.'))
    except (ValueError, TypeError):
        return 0.0


def is_forbidden_negative(key: str) -> bool:
    """Sprawdza, czy dana pozycja bilansowa ma bezwzględny zakaz wartości ujemnych."""
    base_key = re.sub(r'_(current|previous)$', '', key, flags=re.IGNORECASE)

    # Aktywa są wykazywane w wartościach netto (zawsze >= 0)
    if base_key.startswith('Aktywa'):
        return True

    # Pasywa: Całość, Zobowiązania (Pasywa_B) i ich sub-pozycje nie mogą być ujemne.
    # Kapitał własny (Pasywa_A) może być ujemny (np. strata z lat ubiegłych).
    if base_key in ['Pasywa', 'Pasywa_B', 'Pasywa_A_I'] or base_key.startswith('Pasywa_B_'):
        return True

    return False


NON_EXHAUSTIVE_LEVEL2_SCHEMAS: Set[str] = {
    'BilansJednostkaMikro', 'SprFinJednostkaMikroWZlotych', 'JednostkaMikro',
}


def validate_balance_sheet_df(
    df: pd.DataFrame,
    schema_col: str = 'balance_sheet_schema',
    abs_tolerance: float = 1.0,   # Dopuszczalny błąd zaokrągleń w PLN (np. 1 zł)
    rel_tolerance: float = 0.001  # Dopuszczalny błąd względny (0.1%)
) -> pd.DataFrame:
    """
    Waliduje sumy kontrolne (Poziom 0/1/2) oraz niedozwolone wartości ujemne w DataFrame.
    """
    results = []
    
    # Wyciągamy kolumny bilansowe raz przed pętlą
    balance_cols = [c for c in df.columns if re.match(r'^(Aktywa|Pasywa)_', str(c), re.IGNORECASE)]
    
    # Pre-kompilacja wzorców Regex dla poprawy wydajności
    pattern_lvl1_cache = {
        sec: {
            p: re.compile(rf"^{sec}_([A-Z])_{p}$", re.IGNORECASE) 
            for p in ["current", "previous"]
        } for sec in ["Aktywa", "Pasywa"]
    }

    for row_idx, row in df.iterrows():
        data = {str(col): safe_float(row[col]) for col in balance_cols}
        row_id = row.get('krs', row.get('KRS', row_idx))
        period_end_dte = row.get('report_period_end_dte', None)
        row_schema = row.get(schema_col) if schema_col and schema_col in df.columns else None
        skip_level2 = row_schema in NON_EXHAUSTIVE_LEVEL2_SCHEMAS

        periods = ["current", "previous"]

        # --- TEST 1: Walidacja wartości ujemnych ---
        for col_key, val in data.items():
            if val < 0 and is_forbidden_negative(col_key):
                period = "current" if col_key.lower().endswith("_current") else "previous"
                results.append({
                    "row_id": row_id,
                    "report_period_end_dte": period_end_dte,
                    "balance_sheet_schema": row_schema,
                    "analizowany_okres": period,
                    "relacja": f"Wartość ujemna niedozwolona: {col_key}",
                    "rodzic": col_key,
                    "wartosc_rodzica": val,
                    "dzieci": [],
                    "suma_dzieci": 0.0,
                    "roznica": round(abs(val), 2),
                    "roznica_procentowa": 100.0,
                    "status": "FAIL",
                })

        # --- TEST 2: Walidacja sum kontrolnych ---
        def check_sum(parent_key: str, child_keys: List[str], label: str):
            if not child_keys or parent_key not in data:
                return

            parent_val = data.get(parent_key, 0.0)
            children_vals = [data.get(k, 0.0) for k in child_keys]
            children_val = sum(children_vals)

            diff = abs(parent_val - children_val)
            max_val = max(abs(parent_val), abs(children_val))

            # Poprawiona tolerancja: wyższy z dwóch progów (sztywny bufor złoty vs mały % )
            allowed_tolerance = max(abs_tolerance, max_val * rel_tolerance)
            passed = diff <= allowed_tolerance

            rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

            results.append({
                "row_id": row_id,
                "report_period_end_dte": period_end_dte,
                "balance_sheet_schema": row_schema,
                "analizowany_okres": label.split()[0],
                "relacja": label,
                "rodzic": parent_key,
                "wartosc_rodzica": parent_val,
                "dzieci": child_keys,
                "suma_dzieci": round(children_val, 2),
                "roznica": round(diff, 2),
                "roznica_procentowa": round(rel_diff, 2),
                "status": "PASS" if passed else "FAIL",
            })

        for period in periods:
            # Poziom 0: Aktywa == Pasywa
            akt_lvl0, pas_lvl0 = f"Aktywa_{period}", f"Pasywa_{period}"
            if akt_lvl0 in data and pas_lvl0 in data:
                check_sum(akt_lvl0, [pas_lvl0], f"{period} - Poziom 0: Aktywa == Pasywa")

            # Poziom 1 i 2
            for section in ["Aktywa", "Pasywa"]:
                root = f"{section}_{period}"
                pattern_lvl1 = pattern_lvl1_cache[section][period]

                lvl1_children = [k for k in data.keys() if pattern_lvl1.match(k)]
                lvl1_children.sort(key=lambda x: pattern_lvl1.match(x).group(1))

                if lvl1_children:
                    check_sum(root, lvl1_children, f"{period} - Poziom 1: {section} = sum(A..I)")

                if skip_level2:
                    continue

                for parent_lvl1 in lvl1_children:
                    match = pattern_lvl1.match(parent_lvl1)
                    if not match:
                        continue
                    letter = match.group(1)

                    # Dynamiczna obsługa cyfr rzymskich i arabskich na Poziomie 2
                    pattern_lvl2 = re.compile(
                        rf"^{section}_{letter}_([IVXLCDM]+|\d+)_{period}$", re.IGNORECASE
                    )

                    lvl2_children = [k for k in data.keys() if pattern_lvl2.match(k)]
                    if lvl2_children:
                        check_sum(
                            parent_lvl1,
                            lvl2_children,
                            f"{period} - Poziom 2: {section}_{letter} = sum(dzieci)"
                        )

    return pd.DataFrame(results)
