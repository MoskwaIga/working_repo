"""
Buduje data/stage/balance_sheet_cor.parquet: oryginalna tabela balance_sheet
+ flagi walidacyjne per raport.

### KONFIG - dostosuj do swojego pipeline'u ###
"""
from pathlib import Path
import pandas as pd

from validate_balance_sheet import validate_balance_sheet_df
from common import months_between

# --- KONFIG: dostosuj sciezki i nazwy kolumn do swoich danych ---
INPUT_PATH = "data/stage/balance_sheet.parquet"          # <- ZMIEN jesli inna
OUTPUT_PATH = "data/stage/balance_sheet_cor.parquet"
ID_COL = "report_id"                                       # <- unikalny klucz raportu
START_COL = "report_period_start_dte"
END_COL = "report_period_end_dte"


def build_report_level_flags(df: pd.DataFrame, id_col: str = ID_COL) -> pd.DataFrame:
    """Zwraca DataFrame [id_col, is_valid_sums, has_forbidden_negative] - jeden
    wiersz na raport, wyliczony z 'dlugiej' tabeli wynikow walidacji."""
    long_results = validate_balance_sheet_df(df, id_cols=(id_col,))

    if long_results.empty:
        return pd.DataFrame({id_col: df[id_col], "is_valid_sums": pd.NA,
                              "has_forbidden_negative": pd.NA})

    sums = long_results[long_results["check_type"] != "negative_value"]
    is_valid = (
        sums.groupby(id_col)["status"]
        .apply(lambda s: not (s == "fail").any())
        .rename("is_valid_sums")
    )

    negatives = (
        long_results.groupby(id_col)["has_forbidden_negative"]
        .any()
        .rename("has_forbidden_negative")
    )

    flags = pd.concat([is_valid, negatives], axis=1).reset_index()
    flags["is_valid_sums"] = flags["is_valid_sums"].astype("boolean")
    flags["has_forbidden_negative"] = flags["has_forbidden_negative"].astype("boolean")
    return flags


def build(df: pd.DataFrame) -> pd.DataFrame:
    flags = build_report_level_flags(df)

    out = df.merge(flags, on=ID_COL, how="left")
    # raporty, ktorych walidator w ogole nie zobaczyl (np. brak balance_sheet_schema)
    out["is_valid_sums"] = out["is_valid_sums"].astype("boolean")
    out["has_forbidden_negative"] = out["has_forbidden_negative"].astype("boolean")

    out["report_period_months"] = out.apply(
        lambda r: months_between(r[START_COL], r[END_COL]), axis=1
    )
    return out


if __name__ == "__main__":
    df_in = pd.read_parquet(INPUT_PATH)
    df_out = build(df_in)

    out_path = Path(OUTPUT_PATH)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    df_out.to_parquet(out_path, index=False)

    print(f"Zapisano {len(df_out)} wierszy -> {out_path}")
    print(df_out[["is_valid_sums", "has_forbidden_negative"]].value_counts(dropna=False))
