import re
import pandas as pd

def safe_float(val) -> float:
    """Konwertuje wartości liczbowe z obsługą pustych pól i formatów księgowych."""
    if pd.isna(val):
        return 0.0
    if isinstance(val, (int, float)):
        return float(val)
    val_str = str(val).strip()
    if val_str.startswith('(') and val_str.endswith(')'):
        val_str = '-' + val_str[1:-1]
    try:
        return float(val_str.replace(' ', '').replace(',', '.'))
    except (ValueError, TypeError):
        return 0.0

def validate_rzis_df(df: pd.DataFrame) -> pd.DataFrame:
    """
    Sprawdza każde równanie kaskadowe i hierarchiczne w RZiS z tolerancją 1%.
    """
    results = []
    
    # Wykrywanie kolumn RZiS (np. A_current, A_I_previous, B_VIII_current)
    rzis_pattern = re.compile(r'^[A-Z](_[IVXLCDM]+)*_(current|previous)$', re.IGNORECASE)
    rzis_cols = [c for c in df.columns if rzis_pattern.match(str(c))]

    for row_idx, row in df.iterrows():
        data = {str(col): safe_float(row[col]) for col in rzis_cols}
        krs = row.get('krs', row_idx)
        period_end_dte = row.get('report_period_end_dte', None)

        periods = ["current", "previous"]

        def check_equation(target_key: str, calc_val: float, label: str, period: str, child_keys: list = None):
            if target_key not in data:
                return

            target_val = data.get(target_key, 0.0)
            diff = abs(target_val - calc_val)
            max_val = max(abs(target_val), abs(calc_val))
            tolerance = 0.01 * max_val if max_val > 0 else 0.0

            # Jeśli sprawdzamy podpozycje i wszystkie wynoszą 0.0 -> PASS (brak uszczegółowienia)
            if child_keys and all(data.get(k, 0.0) == 0.0 for k in child_keys):
                passed = True
            else:
                passed = diff <= tolerance

            rel_diff = (diff / max_val * 100) if max_val > 0 else 0.0

            results.append({
                "krs": krs,
                "report_period_end_dte": period_end_dte,
                "analizowany_okres": period,
                "relacja": label,
                "pozycja_wykazana": target_key,
                "wartosc_wykazana": round(target_val, 2),
                "wartosc_obliczona": round(calc_val, 2),
                "roznica": round(diff, 2),
                "roznica_procentowa": round(rel_diff, 2),
                "status": "PASS" if passed else "FAIL"
            })

        for p in periods:
            # Wykrywanie wariantu RZiS na podstawie obecności pozycji końcowych
            is_kalkulacyjny = f"O_{p}" in data or (f"M_{p}" in data and f"N_{p}" in data)

            if is_kalkulacyjny:
                # --- WARIANT KALKULACYJNY ---
                if f"A_{p}" in data and f"B_{p}" in data:
                    check_equation(f"C_{p}", data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0), f"{p} - C = A - B (Zysk ze sprzedaży brutto)", p)
                if f"C_{p}" in data and f"D_{p}" in data and f"E_{p}" in data:
                    check_equation(f"F_{p}", data.get(f"C_{p}", 0.0) - data.get(f"D_{p}", 0.0) - data.get(f"E_{p}", 0.0), f"{p} - F = C - D - E (Zysk ze sprzedaży)", p)
                if f"F_{p}" in data and f"G_{p}" in data and f"H_{p}" in data:
                    check_equation(f"I_{p}", data.get(f"F_{p}", 0.0) + data.get(f"G_{p}", 0.0) - data.get(f"H_{p}", 0.0), f"{p} - I = F + G - H (EBIT)", p)
                if f"I_{p}" in data and f"J_{p}" in data and f"K_{p}" in data:
                    check_equation(f"L_{p}", data.get(f"I_{p}", 0.0) + data.get(f"J_{p}", 0.0) - data.get(f"K_{p}", 0.0), f"{p} - L = I + J - K (Zysk brutto)", p)
                if f"L_{p}" in data and f"M_{p}" in data and f"N_{p}" in data:
                    check_equation(f"O_{p}", data.get(f"L_{p}", 0.0) - data.get(f"M_{p}", 0.0) - data.get(f"N_{p}", 0.0), f"{p} - O = L - M - N (Zysk netto)", p)
            else:
                # --- WARIANT PORÓWNAWCZY ---
                if f"A_{p}" in data and f"B_{p}" in data:
                    check_equation(f"C_{p}", data.get(f"A_{p}", 0.0) - data.get(f"B_{p}", 0.0), f"{p} - C = A - B (Zysk ze sprzedaży)", p)
                if f"C_{p}" in data and f"D_{p}" in data and f"E_{p}" in data:
                    check_equation(f"F_{p}", data.get(f"C_{p}", 0.0) + data.get(f"D_{p}", 0.0) - data.get(f"E_{p}", 0.0), f"{p} - F = C + D - E (EBIT)", p)
                if f"F_{p}" in data and f"G_{p}" in data and f"H_{p}" in data:
                    check_equation(f"I_{p}", data.get(f"F_{p}", 0.0) + data.get(f"G_{p}", 0.0) - data.get(f"H_{p}", 0.0), f"{p} - I = F + G - H (Zysk brutto)", p)
                if f"I_{p}" in data and f"J_{p}" in data and f"K_{p}" in data:
                    check_equation(f"L_{p}", data.get(f"I_{p}", 0.0) - data.get(f"J_{p}", 0.0) - data.get(f"K_{p}", 0.0), f"{p} - L = I - J - K (Zysk netto)", p)

            # --- SUMY HIERARCHICZNE PODPOZYCJI (A = sum(A_I..A_IV), B = sum(B_I..B_VIII) itp.) ---
            pattern_lvl1 = re.compile(rf"^([A-Z])_{p}$", re.IGNORECASE)
            lvl1_parents = [k for k in data.keys() if pattern_lvl1.match(k)]

            for parent_key in lvl1_parents:
                letter = pattern_lvl1.match(parent_key).group(1)
                pattern_lvl2 = re.compile(rf"^{letter}_([IVXLCDM]+)_{p}$", re.IGNORECASE)
                
                child_keys = [k for k in data.keys() if pattern_lvl2.match(k)]
                if child_keys:
                    calc_children_sum = sum(data.get(k, 0.0) for k in child_keys)
                    check_equation(
                        parent_key, 
                        calc_children_sum, 
                        f"{p} - Suma podpozycji dla {letter}", 
                        p, 
                        child_keys=child_keys
                    )

    return pd.DataFrame(results)
